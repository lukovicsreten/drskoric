---
import Icon from './Icon.astro';
import Sparkle from './Sparkle.astro';
import { siteConfig, services } from '../data/siteConfig';

const { formEndpoint, phone } = siteConfig;
const hasForm = formEndpoint.trim() !== '';

const inputClass =
  'mt-2 block w-full rounded-xl border border-navy/15 bg-white px-4 py-3 text-base text-navy placeholder:text-ink-soft/70 transition focus:border-teal focus:ring-2 focus:ring-teal/25 focus:outline-none';
const labelClass = 'block text-sm font-semibold text-navy';
---

<div class="card relative overflow-hidden p-7 sm:p-10">
  <Sparkle size={28} class="absolute top-6 right-6 text-mint" />
  <p class="eyebrow">Zakazivanje</p>
  <h3 class="mt-3 text-2xl font-semibold sm:text-3xl">Zakažite termin</h3>

  {
    hasForm ? (
      <>
        <p class="mt-3 max-w-2xl text-ink-soft">
          Popunite formu i javićemo vam se da dogovorimo tačan termin. Polja označena zvezdicom su obavezna.
        </p>

        <form id="appointment-form" action={formEndpoint} method="POST" class="mt-8 grid gap-5 sm:grid-cols-2" novalidate>
          <div>
            <label for="ime" class={labelClass}>
              Ime i prezime <span aria-hidden="true" class="text-teal">*</span>
            </label>
            <input id="ime" name="ime_i_prezime" type="text" autocomplete="name" required class={inputClass} />
          </div>
          <div>
            <label for="telefon" class={labelClass}>
              Telefon <span aria-hidden="true" class="text-teal">*</span>
            </label>
            <input
              id="telefon"
              name="telefon"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              required
              placeholder="06x xxx xxxx"
              class={inputClass}
            />
          </div>
          <div>
            <label for="usluga" class={labelClass}>Željena usluga</label>
            <select id="usluga" name="usluga" class={inputClass}>
              <option value="">Izaberite uslugu</option>
              {services.map((s) => (
                <option value={s.title}>{s.title}</option>
              ))}
              <option value="Nisam siguran/na">Nisam siguran/na – potreban mi je pregled</option>
            </select>
          </div>
          <fieldset>
            <legend class={labelClass}>Željeni deo dana</legend>
            <div class="mt-2 flex gap-3">
              {['Prepodne', 'Popodne'].map((part, i) => (
                <label class="flex flex-1 cursor-pointer items-center gap-2 rounded-xl border border-navy/15 bg-white px-4 py-3 transition has-[:checked]:border-teal has-[:checked]:bg-mint-light">
                  <input type="radio" name="deo_dana" value={part} checked={i === 0} class="size-4 accent-teal" />
                  {part}
                </label>
              ))}
            </div>
          </fieldset>
          <div class="sm:col-span-2">
            <label for="poruka" class={labelClass}>Poruka</label>
            <textarea
              id="poruka"
              name="poruka"
              rows="4"
              class={inputClass}
              placeholder="Npr. koji dan vam najviše odgovara ili kratak opis problema"
            />
          </div>

          <!-- Zamka za spam botove (Formspree) -->
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center">
            <button type="submit" class="btn btn-primary disabled:cursor-wait disabled:opacity-70">
              <Icon name="send" size={18} />
              <span data-label>Pošaljite zahtev</span>
            </button>
            <p id="form-error-required" class="hidden text-sm font-medium text-red-700" role="alert">
              Molimo upišite ime i prezime i broj telefona.
            </p>
          </div>
        </form>

        <div
          id="form-success"
          class="mt-8 hidden items-start gap-3 rounded-xl bg-mint-light p-5 text-navy"
          role="status"
          tabindex="-1"
        >
          <Icon name="circle-check" size={24} class="shrink-0 text-teal" />
          <p class="font-semibold">Hvala! Javićemo vam se u najkraćem roku.</p>
        </div>
        <div
          id="form-failure"
          class="mt-6 hidden items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-5 text-navy"
          role="alert"
        >
          <Icon name="circle-alert" size={24} class="shrink-0 text-red-700" />
          <p>
            Slanje trenutno nije uspelo. Molimo pozovite nas na{' '}
            <a href={phone.href} class="font-semibold text-teal underline">
              {phone.display}
            </a>{' '}
            ili pišite na Viber.
          </p>
        </div>
      </>
    ) : (
      <>
        <p class="mt-3 max-w-2xl text-ink-soft">
          Termin najlakše zakazujete telefonom ili porukom na Viber. Rado ćemo odgovoriti i na sva vaša pitanja.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href={phone.href} class="btn btn-primary text-base">
            <Icon name="phone" size={20} />
            Pozovite {phone.display}
          </a>
          <a href={siteConfig.viberHref} class="btn btn-outline text-base">
            <Icon name="message-circle" size={20} />
            Viber
          </a>
        </div>
      </>
    )
  }
</div>

<script>
  const form = document.getElementById('appointment-form') as HTMLFormElement | null;

  if (form) {
    const success = document.getElementById('form-success')!;
    const failure = document.getElementById('form-failure')!;
    const required = document.getElementById('form-error-required')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.querySelector('[data-label]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      failure.classList.add('hidden');
      failure.classList.remove('flex');

      const name = form.elements.namedItem('ime_i_prezime') as HTMLInputElement;
      const tel = form.elements.namedItem('telefon') as HTMLInputElement;
      const missing = [name, tel].filter((el) => el.value.trim() === '');
      [name, tel].forEach((el) => el.setAttribute('aria-invalid', String(missing.includes(el))));
      required.classList.toggle('hidden', missing.length === 0);
      if (missing.length) {
        missing[0].focus();
        return;
      }

      button.disabled = true;
      label.textContent = 'Šaljem…';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(String(response.status));
        form.classList.add('hidden');
        success.classList.remove('hidden');
        success.classList.add('flex');
        success.focus();
      } catch {
        failure.classList.remove('hidden');
        failure.classList.add('flex');
      } finally {
        button.disabled = false;
        label.textContent = 'Pošaljite zahtev';
      }
    });
  }
</script>
