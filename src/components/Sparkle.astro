interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className = 'text-mint' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <path d="M12 0c.7 6.6 4.8 10.8 12 12-7.2 1.2-11.3 5.4-12 12-.7-6.6-4.8-10.8-12-12C7.2 10.8 11.3 6.6 12 0Z" />
</svg>
